>\t\tinterrupt</span></span>\r\n<span id=\"cb2-136\"><span class=\"co\">\t*/</span></span>\r\n<span id=\"cb2-137\">\tt0mmio <span class=\"op\">=</span> <span class=\"op\">(</span>uint32<span class=\"op\">*)</span><span class=\"bn\">0x13000000</span><span class=\"op\">;</span></span>\r\n<span id=\"cb2-138\">\t</span>\r\n<span id=\"cb2-139\">\tt0mmio<span class=\"op\">[</span>REG_INTCLR<span class=\"op\">]</span> <span class=\"op\">=</span> <span class=\"dv\">1</span><span class=\"op\">;</span></span>\r\n<span id=\"cb2-140\">\t</span>\r\n<span id=\"cb2-141\">\t<span class=\"co\">/*</span></span>\r\n<span id=\"cb2-142\"><span class=\"co\">\t\tGet SWI argument (index).</span></span>\r\n<span id=\"cb2-143\"><span class=\"co\">\t*/</span></span>\r\n<span id=\"cb2-144\">\t<span class=\"cf\">if</span> <span class=\"op\">(</span>type <span class=\"op\">==</span> ARM4_XRQ_SWINT<span class=\"op\">)</span> <span class=\"op\">{</span></span>\r\n<span id=\"cb2-145\">\t\tswi <span class=\"op\">=</span> <span class=\"op\">((</span>uint32<span class=\"op\">*)((</span>uintptr<span class=\"op\">)</span>lr <span class=\"op\">-</span> <span class=\"dv\">4</span><span class=\"op\">))[</span><span class=\"dv\">0</span><span class=\"op\">]</span> <span class=\"op\">&amp;</span> <span class=\"bn\">0xffff</span><span class=\"op\">;</span></span>\r\n<span id=\"cb2-146\">\t\t</span>\r\n<span id=\"cb2-147\">\t\t<span class=\"cf\">if</span> <span class=\"op\">(</span>swi <span class=\"op\">==</span> <span class=\"dv\">4</span><span class=\"op\">)</span> <span class=\"op\">{</span></span>\r\n<span id=\"cb2-148\">\t\t\tk_serdbg_putc<span class=\"op\">(</span><span class=\"ch\">'@'</span><span class=\"op\">);</span></span>\r\n<span id=\"cb2-149\">\t\t<span class=\"op\">}</span></span>\r\n<span id=\"cb2-150\">\t<span class=\"op\">}</span></span>\r\n<span id=\"cb2-151\">\t</span>\r\n<span id=\"cb2-152\">\t<span class=\"cf\">if</span> <span class=\"op\">(</span>type <span class=\"op\">!=</span> ARM4_X